# SkyPilot API server for remote integration tests.
# Installs SkyPilot (base only), configures ~/.slurm/config pointing
# at slurmctld, and starts the API server.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /skypilot

COPY tests/integration_tests/slurm_tunnel/entrypoint-apiserver.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 46580

ENTRYPOINT ["/entrypoint.sh"]
